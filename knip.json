{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["app/server.ts", "app/client.ts", "app/routes/**/*.{ts,tsx}", "app/style.css", "scripts/**/*.mjs"],
	"project": ["app/**/*.{ts,tsx,mdx,css}", "scripts/**/*.mjs"],
	"ignoreBinaries": ["lat"],
	"ignoreDependencies": ["@hono/cli", "workerd", "lat.md"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "warn",
		"types": "warn"
	}
}
