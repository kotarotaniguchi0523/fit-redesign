#!/bin/sh
# virtiofs（symlink 禁止）環境向けの pnpm ラッパー。
#
# pnpm はパッケージ導入後に node_modules/.bin へシンボリックリンクを張るが、
# この環境では EPERM で失敗する。導入自体は完了しているため、
# その失敗を無視して .bin をシムとして張り直し、呼び出し元（cf 等）へ成功を返す。
REAL_PNPM="${REAL_PNPM:-/usr/local/share/npm-global/bin/pnpm}"
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

case "$1" in
	install | i | add | update | up | import)
		"$REAL_PNPM" "$@" --config.node-linker=hoisted
		status=$?
		node "$PROJECT_ROOT/scripts/fix-bin-shims.mjs" || true
		# パッケージ導入自体が失敗していなければ成功として扱う
		if [ "$status" -ne 0 ]; then
			# .bin の symlink 失敗のみなら node_modules は存在する
			[ -d "$PROJECT_ROOT/node_modules/remix" ] || exit "$status"
		fi
		exit 0
		;;
	*)
		exec "$REAL_PNPM" "$@"
		;;
esac
