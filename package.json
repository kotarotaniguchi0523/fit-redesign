{
	"name": "fit-redesign",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.3.0"
	},
	"scripts": {
		"dev": "node scripts/build-css.mjs && node scripts/build-client.mjs && wrangler dev",
		"build": "node scripts/build-css.mjs && node scripts/build-client.mjs && wrangler deploy --dry-run --outdir dist",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"doctor": "remix doctor",
		"routes": "remix routes",
		"test": "NODE_ENV=test remix test",
		"format": "biome format --write .",
		"check": "biome ci .",
		"lat:lint": "lat check",
		"lint": "pnpm check && pnpm lat:lint",
		"db:migrate:local": "wrangler d1 migrations apply fit-timer-db --local",
		"db:query:local": "wrangler d1 execute fit-timer-db --local --command",
		"e2e": "pnpm build && playwright test",
		"build:css": "node scripts/build-css.mjs",
		"build:client": "node scripts/build-client.mjs"
	},
	"dependencies": {
		"@remix-run/ui": "^0.12.1",
		"remix": "^3.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@types/node": "^24.0.0",
		"lat.md": "^0.12.2",
		"typescript": "^7.0.2",
		"wrangler": "^4.149.0"
	}
}
