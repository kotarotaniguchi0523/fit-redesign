{
	"name": "fit-redesign",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.3.0"
	},
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"preview": "cf dev --local",
		"deploy": "cf deploy",
		"types": "cf workers types",
		"typecheck": "tsc --noEmit",
		"doctor": "remix doctor",
		"routes": "remix routes",
		"test": "NODE_ENV=test remix test",
		"format": "biome format --write .",
		"check": "biome ci .",
		"lat:lint": "lat check",
		"lint": "pnpm check && pnpm lat:lint",
		"db:migrate:local": "cf d1 migrations apply --local --dir db/migrations",
		"db:query:local": "cf d1 query --local",
		"e2e": "pnpm build && playwright test"
	},
	"dependencies": {
		"@remix-run/ui": "^0.12.1",
		"remix": "^3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/vite-plugin": "beta",
		"@cloudflare/workers-types": "^5.20261012.1",
		"@playwright/test": "^1.63.0",
		"@types/node": "^24.0.0",
		"cf": "^1.0.0-beta.14",
		"lat.md": "^0.12.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
