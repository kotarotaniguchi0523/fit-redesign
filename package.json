{
	"name": "fit-redesign",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode client && vite build",
		"preview": "wrangler dev",
		"format": "biome format --write .",
		"check": "biome ci .",
		"lint": "pnpm check && pnpm lat:lint",
		"lat:lint": "lat check",
		"typecheck": "tsgo --noEmit",
		"typecheck:full": "tsgo --noEmit",
		"knip": "knip",
		"db:migrate:local": "wrangler d1 migrations apply fit-timer-db --local",
		"db:baseline:local": "node scripts/db-baseline.mjs",
		"db:generate": "node scripts/generate-d1-migration.mjs",
		"db:check": "drizzle-kit check",
		"db:query:local": "wrangler d1 execute fit-timer-db --local --command",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"deploy": "wrangler deploy",
		"e2e": "pnpm build && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/workers-types": "^5.20260922.1",
		"@hono/cli": "^0.1.11",
		"@hono/vite-build": "^1.11.1",
		"@hono/vite-dev-server": "^0.26.1",
		"@mdx-js/rollup": "^3.1.1",
		"@playwright/test": "1.63.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^5.0.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "1.0.0-rc.4",
		"jsdom": "^30.1.0",
		"knip": "^6.37.0",
		"lat.md": "0.12.2",
		"miniflare": "^4.20260730.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"workerd": "^1.20260922.1",
		"wrangler": "^4.136.1"
	},
	"dependencies": {
		"@hono/structured-logger": "1.0.0",
		"@hono/zod-validator": "^0.9.1",
		"dayjs": "^1.11.23",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.8",
		"honox": "^0.1.61",
		"neverthrow": "^8.2.0",
		"zod": "^4.6.5"
	}
}
