{
	"compilerOptions": {
		"strict": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node", "remix/assets/types/hmr"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"noEmit": true
	},
	"include": ["app", "cloudflare.config.ts", "vite.config.ts", ".cloudflare/types"],
	"exclude": ["dist", "node_modules", "legacy"]
}
